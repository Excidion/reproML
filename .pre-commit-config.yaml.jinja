repos:
- repo: https://github.com/pre-commit/pre-commit-hooks
  rev: v4.4.0
  hooks:
  - id: check-yaml
    args: ['--unsafe'] # avoid problems with mkdocs mermaid extension
    stages:
    - commit
  - id: check-toml
    stages:
    - commit
  - id: end-of-file-fixer
    exclude: |
        (?x)^(
            {{_copier_conf.answers_file}}|
            docs/licenses.md
        )$
    stages:
    - commit
  - id: trailing-whitespace
    exclude: |
        (?x)^(
            {{_copier_conf.answers_file}}|
            docs/licenses.md
        )$
    stages:
    - commit
- repo: https://github.com/jumanjihouse/pre-commit-hooks
  rev: '3.0.0'
  hooks:
  - id: forbid-binary
    stages:
    - commit
- repo: local
  hooks:
  - id: ruff
    name: ruff
    entry: uv run ruff check
    args: [ --fix ]
    language: system
    types: [file, python]
    stages:
    - commit
  - id: ruff-format
    name: ruff-format
    entry: uv run ruff format
    language: system
    types: [file, python]
    stages:
    - commit
  - id: interrogate
    name: interrogate
    entry: uv run interrogate
    language: system
    types: [file, python]
    stages:
    - commit
{%- if license != 'NO_LICENSE' %}
  - id: licensecheck
    name: licensecheck
    entry: uv run licensecheck
    args: [ --zero ]
    language: system
    pass_filenames: false
    stages:
    - commit
{%- endif %}
{%- if use_dvc %}
  - id: dvc-pre-commit
    name: DVC pre-commit
    entry: uv run dvc git-hook pre-commit
    language: system
    require_serial: true
    verbose: true
    stages:
    - commit
  - id: dvc-pre-push
    name: DVC pre-push
    entry: uv run dvc git-hook pre-push
    language: system
    require_serial: true
    stages:
    - push
  - id: dvc-post-checkout
    name: DVC post-checkout
    entry: uv run dvc git-hook post-checkout
    language: system
    require_serial: true
    stages:
    - post-checkout
    always_run: true
{%- endif %}
