[project]
name = "{{ project_name_slug }}"
version = "0.1.0"
description = "{{ project_description }}"
authors = [
    {name = "{{ author }}", email = "{{ author_email }}"},
]
readme = "README.md"
requires-python = ">={{ python_version }}"
dependencies = [
{%- if use_dvc %}
    "dvc[{{ remote_type }}]>=3.55.2",
{%- endif %}
    "python-dotenv>=1.0.1",
]

[dependency-groups]
dev = [
    "interrogate>=1.7.0",
    "ipykernel>=6.29.5",
    "mkdocs-gen-files>=0.5.0",
    "mkdocs-jupyter>=0.25.0",
    "mkdocs-literate-nav>=0.6.1",
    "mkdocs-material>=9.5.35",
    "mkdocs-section-index>=0.3.9",
    "mkdocstrings[python]>=0.26.1",
    "pre-commit>=4.0.1",
    "ruff>=0.6.6",
]

[tool.interrogate]
ignore-init-method = true
ignore-init-module = true
ignore-module = true
fail-under = 100
verbose = 1
generate-badge = "docs/helper"
badge-format = "svg"

[build-system]
requires = ["uv_build>=0.8.10,<0.9.0"]
build-backend = "uv_build"

[tool.uv.build-backend]
module-name = "src"
module-root = ""
namespace = true
